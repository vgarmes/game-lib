generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] // to use Neon serverless driver
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cover {
  id        Int      @id @default(autoincrement())
  publicId  String
  secureUrl String
  filename  String
  format    String
  width     Int
  height    Int
  byteSize  Int
  checksum  String
  gameId    Int?     @unique
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId])
}

enum GameStatus {
  backlog
  in_progress
  completed
}

model Game {
  id            Int        @id @default(autoincrement())
  title         String
  inCollection  Boolean?   @default(true)
  status        GameStatus @default(backlog)
  edition       String?
  releaseDate   DateTime?  @db.Date
  completedDate DateTime?  @db.Date
  buyDate       DateTime?  @db.Date
  buyPrice      Float?
  developerId   Int?
  developer     Developer? @relation(fields: [developerId], references: [id])
  rating        Int?
  comment       String?
  platformId    Int?
  platform      Platform?  @relation(fields: [platformId], references: [id])
  cover         Cover?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([platformId, title])
  @@index([status, completedDate(sort: Desc)])
}

model Platform {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  manufacturer String?
  games        Game[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Developer {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  country   String?
  games     Game[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
